<!DOCTYPE html>
<html lang="id">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
        <title>Pasal RP — Rebelions Roleplay</title>
        <style>
            :root {
                box-sizing: border-box;
                padding-top: env(safe-area-inset-top,0px);
                padding-bottom: env(safe-area-inset-bottom,0px);
                --bg: #f6f2f7;
                --card: #fff;
                --tx: #241a28;
                --mut: #75687a;
                --bd: #e2d8e6;
                --ac: #9a4dd1;
                --ac2: #f1e4fb;
                --red: #c62f4a;
                --amb: #a86a00
            }

            @media (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) {
                    --bg:#150e17;
                    --card: #201626;
                    --tx: #f1e9f4;
                    --mut: #9d8fa3;
                    --bd: #33263a;
                    --ac: #c07df0;
                    --ac2: #33223f;
                    --red: #ff6b86;
                    --amb: #f2b84b;
                    color-scheme: dark
                }
            }

            :root[data-theme="dark"] {
                --bg: #150e17;
                --card: #201626;
                --tx: #f1e9f4;
                --mut: #9d8fa3;
                --bd: #33263a;
                --ac: #c07df0;
                --ac2: #33223f;
                --red: #ff6b86;
                --amb: #f2b84b;
                color-scheme: dark
            }

            html {
                scroll-padding-top: env(safe-area-inset-top,0px)
            }

            * {
                box-sizing: border-box
            }

            body {
                margin: 0;
                background: var(--bg);
                color: var(--tx);
                font: 15px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif
            }

            .wrap {
                max-width: 1040px;
                margin: 0 auto;
                padding: 16px
            }

            header {
                display: flex;
                flex-wrap: wrap;
                gap: 12px;
                align-items: center;
                justify-content: space-between;
                margin-bottom: 16px
            }

            .logo {
                font-weight: 800;
                font-size: 22px
            }

            .logo b {
                color: var(--ac)
            }

            .logo small {
                display: block;
                font-size: 11px;
                letter-spacing: .14em;
                color: var(--mut);
                font-weight: 500
            }

            nav {
                display: flex;
                gap: 6px;
                flex-wrap: wrap
            }

            nav a {
                padding: 7px 12px;
                border-radius: 8px;
                color: var(--mut);
                text-decoration: none;
                border: 1px solid transparent
            }

            nav a.on {
                background: var(--ac2);
                color: var(--ac);
                border-color: var(--bd)
            }

            .card {
                background: var(--card);
                border: 1px solid var(--bd);
                border-radius: 14px;
                padding: 16px;
                margin-bottom: 14px
            }

            h1 {
                font-size: 24px;
                margin: 0 0 4px
            }

            h2 {
                font-size: 17px;
                margin: 0 0 10px
            }

            .mut {
                color: var(--mut)
            }

            .sm {
                font-size: 13px
            }

            .stats {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(140px,1fr));
                gap: 10px
            }

            .stats .card {
                margin: 0
            }

            .stats b {
                display: block;
                font-size: 28px
            }

            input[type=search] {
                width: 100%;
                padding: 11px 14px;
                border-radius: 10px;
                border: 1px solid var(--bd);
                background: var(--bg);
                color: var(--tx);
                font-size: 15px
            }

            button,.btn {
                background: var(--ac);
                color: #fff;
                border: 0;
                border-radius: 10px;
                padding: 9px 14px;
                font-size: 14px;
                cursor: pointer;
                text-decoration: none;
                display: inline-block
            }

            button.ghost {
                background: transparent;
                color: var(--ac);
                border: 1px solid var(--bd)
            }

            .row {
                display: flex;
                gap: 8px;
                margin-top: 10px;
                flex-wrap: wrap;
                align-items: center
            }

            .chip {
                padding: 5px 10px;
                border-radius: 99px;
                border: 1px solid var(--bd);
                background: transparent;
                color: var(--tx);
                font-size: 13px;
                cursor: pointer
            }

            .chip.on {
                background: var(--ac2);
                color: var(--ac);
                border-color: var(--ac)
            }

            .cats {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
                gap: 10px
            }

            .cat {
                cursor: pointer;
                margin: 0
            }

            .cat:hover {
                border-color: var(--ac)
            }

            .cat b {
                display: block
            }

            .cat .n {
                font-size: 12px;
                color: var(--ac);
                font-weight: 700
            }

            .tbl {
                overflow-x: auto
            }

            table {
                width: 100%;
                border-collapse: collapse;
                min-width: 600px
            }

            th {
                font-size: 11px;
                letter-spacing: .08em;
                text-align: left;
                color: var(--mut);
                padding: 8px;
                border-bottom: 1px solid var(--bd)
            }

            td {
                padding: 10px 8px;
                border-bottom: 1px solid var(--bd);
                vertical-align: top
            }

            .kode {
                font-weight: 700;
                color: var(--ac);
                white-space: nowrap
            }

            .bd {
                display: inline-block;
                font-size: 11px;
                font-weight: 700;
                padding: 2px 8px;
                border-radius: 99px;
                border: 1px solid currentColor
            }

            .bd.F {
                color: var(--red)
            }

            .bd.M {
                color: var(--amb)
            }

            .star {
                background: none;
                color: var(--mut);
                border: 0;
                font-size: 18px;
                padding: 2px 6px
            }

            .star.on {
                color: #e6a700
            }

            .empty {
                text-align: center;
                padding: 30px;
                color: var(--mut)
            }

            .kgrid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 14px
            }

            @media(max-width: 720px) {
                .kgrid {
                    grid-template-columns:1fr
                }
            }

            .pick {
                padding: 9px 10px;
                border: 1px solid var(--bd);
                border-radius: 10px;
                margin-bottom: 6px;
                cursor: pointer
            }

            .pick:hover {
                border-color: var(--ac);
                background: var(--ac2)
            }

            #kres {
                max-height: 440px;
                overflow-y: auto
            }

            .citem {
                display: flex;
                justify-content: space-between;
                gap: 10px;
                align-items: center;
                padding: 9px 0;
                border-bottom: 1px solid var(--bd)
            }

            .qty {
                display: flex;
                align-items: center;
                gap: 8px
            }

            .qty button {
                padding: 4px 10px
            }

            .tot {
                display: grid;
                grid-template-columns: repeat(auto-fit,minmax(120px,1fr));
                gap: 10px;
                margin-top: 14px
            }

            .tot b {
                display: block;
                font-size: 20px;
                color: var(--ac)
            }

            .lic {
                display: flex;
                justify-content: space-between;
                padding: 12px 0;
                border-bottom: 1px solid var(--bd)
            }

            .lic b {
                color: var(--ac)
            }

            footer {
                text-align: center;
                color: var(--mut);
                font-size: 12px;
                padding: 20px 0
            }
        </style>
    </head>
    <body>
        <div class="wrap">
            <header>
                <div class="logo">
                    <b>pasal.</b>
                    <small>REBELIONS ROLEPLAY</small>
                </div>
                <nav id="nav"></nav>
            </header>
            <main id="app"></main>
            <footer>Data pasal dan sanksi mengikuti aturan LSPD Rebelions Roleplay. © 2026 Rebelions Roleplay</footer>
        </div>
        <script>
            const UNIT = 'menit';
            const CATS = {
                1: 'Crimes Against Person',
                2: 'Sexual Assault & Public Decency',
                3: 'Public Health & Safety',
                4: 'Public Peace',
                5: 'Crimes Against Property',
                6: 'Public Justice',
                7: 'Crimes With A Vehicle',
                8: 'Weapon & Firearm Violations'
            };
            // [kode, nama, deskripsi, tipe (M/F), penjara, denda]
            const DATA = [['1.1', 'Criminal Threats', 'Mengancam melukai atau membunuh orang lain/kerabatnya.', 'M', 30, 500], ['1.2', 'Assault & Battery Biasa', 'Mencoba atau berhasil melukai fisik warga sipil.', 'M', 25, 600], ['1.3', 'Assault on State Employee', 'Melukai penegak hukum atau pegawai negeri.', 'M', 40, 700], ['1.4', 'Aggravated Assault', 'Melukai menggunakan senjata mematikan/menyebabkan luka berat.', 'F', 48, 1150], ['1.5', 'Manslaughter', 'Membunuh tanpa rencana (akibat emosi spontan atau kelalaian).', 'F', 72, 1000], ['1.6', 'Murder (1st Degree)', 'Pembunuhan terencana, bom, atau terhadap aparat.', 'F', 132, 1500], ['1.7', 'Murder (2nd Degree)', 'Pembunuhan tanpa rencana matang namun dengan niat jahat.', 'F', 120, 1250], ['1.8', 'Attempted Murder', 'Percobaan pembunuhan terencana.', 'F', 56, 950], ['1.9', 'Kidnapping & False Imprisonment', 'Menyekap atau menculik seseorang tanpa izin.', 'F', 56, 660], ['1.10', 'Robbery & Carjacking', 'Merampas harta/kendaraan menggunakan kekerasan/ancaman.', 'F', 30, 650], ['1.11', 'Stalking & Human Trafficking', 'Menguntit, atau memperdagangkan manusia.', 'F', 36, 750], ['2.1', 'Rape & Sexual Assault', 'Memaksa kontak seksual tanpa persetujuan.', 'F', 56, 540], ['2.2', 'Public Indecency', 'Memperlihatkan alat vital atau perilaku seksual di ruang publik.', 'M', 14, 300], ['2.3', 'Child Endangerment (Indecency)', 'Aktivitas seksual di depan anak di bawah umur.', 'F', 18, 350], ['3.1', 'Possession of Narcotics', 'Memiliki zat ilegal selain ganja medis.', 'M', 4, 100], ['3.2', 'Sale & Distribution of Narcotics', 'Mengedarkan atau memproduksi narkoba.', 'F', 48, 550], ['3.3', 'Illegal Marijuana Possession', 'Ganja melebihi 5 gram atau di bawah umur.', 'M', 6, 50], ['3.4', 'Public Intoxication', 'Mabuk alkohol/narkoba di ruang publik.', 'M', 5, 50], ['3.5', 'Terrorism & Treason', 'Terorisme atau pengkhianatan negara. (999 = Seumur Hidup)', 'F', 999, 9999], ['4.1', 'Riot & Unlawful Assembly', 'Berkerumun untuk tindakan anarkis/kerusuhan.', 'F', 24, 500], ['4.2', 'Disturbing the Peace', 'Berkelahi di tempat umum atau memprovokasi kekerasan.', 'M', 3, 20], ['4.3', 'Emergency Site Trespassing', 'Memasuki zona bahaya/evakuasi resmi.', 'M', 10, 250], ['5.1', 'Burglary & Trespassing', 'Memasuki properti/bangunan orang lain untuk mencuri.', 'F', 30, 250], ['5.2', 'Petty Theft', 'Mencuri barang bernilai di bawah $950.', 'M', 8, 50], ['5.3', 'Grand Theft', 'Mencuri barang di atas $950 atau kendaraan bermotor.', 'F', 15, 250], ['5.4', 'Fraud & Forgery', 'Memalsukan dokumen atau menipu untuk keuntungan finansial.', 'F', 32, 560], ['5.5', 'Vandalism', 'Merusak properti milik orang lain.', 'M', 8, 80], ['6.1', 'Bribery & Corruption', 'Menyuap pejabat publik, atau penyalahgunaan wewenang.', 'F', 64, 645], ['6.2', 'Obstruction & Resisting', 'Menghalangi tugas pegawai negara atau melawan penangkapan.', 'M', 10, 100], ['6.3', 'Perjury & False Reports', 'Kesaksian palsu di pengadilan atau laporan darurat palsu.', 'F', 28, 272], ['6.4', 'Evidence Tampering & Contraband', 'Menghancurkan bukti atau menyelundupkan barang ke penjara.', 'F', 36, 850], ['6.5', 'State Impersonation', 'Menyamar sebagai penegak hukum atau pegawai pemerintah.', 'F', 20, 520], ['7.1', 'Reckless Driving (Basic)', 'Mengemudi ugal-ugalan mengabaikan keselamatan publik.', 'M', 20, 350], ['7.2', 'Reckless Driving (Aggravated)', 'Mengemudi ugal-ugalan yang menyebabkan korban luka.', 'F', 28, 540], ['7.3', 'Driving Under the Influence (DUI)', 'Mengemudi saat mabuk alkohol atau narkoba.', 'F', 24, 246], ['7.4', 'Evading a Peace Officer', 'Melarikan diri dari kejaran aparat pakai kendaraan.', 'M', 16, 156], ['7.5', 'Reckless Evading', 'Melarikan diri dari kejaran polisi secara berbahaya.', 'F', 36, 365], ['7.6', 'Hit and Run (Property)', 'Tabrak lari yang hanya menyebabkan kerusakan benda.', 'M', 10, 154], ['7.7', 'Hit and Run (Injury/Death)', 'Tabrak lari dengan korban jiwa atau luka fisik.', 'F', 35, 464], ['8.1', 'Unlicensed Weapon', 'Membawa senjata mematikan tanpa lisensi.', 'M', 25, 850], ['8.2', 'Illegal/Stolen Firearm', 'Memiliki senjata ilegal, tidak terdaftar, atau curian.', 'F', 40, 900], ['8.3', 'Brandishing a Weapon', 'Menodongkan atau memamerkan senjata untuk mengancam.', 'F', 120, 1500], ['8.4', 'Unlawful Discharge', 'Menembak sembarangan atau Drive-By di tempat umum.', 'F', 36, 550], ['8.5', 'Illegal Mod & Distribution', 'Modifikasi senjata ilegal atau menjual senjata tanpa izin.', 'F', 90, 2500], ['8.6', 'CCW License Violation', 'Membawa senjata di area terlarang atau melanggar aturan lisensi.', 'M', 50, 500], ['8.7', 'Firearm Theft', 'Mencuri senjata api atau gagal lapor kehilangan dalam 48 jam.', 'F', 50, 930], ['8.8', 'Negligent Storage', 'Menyimpan senjata sembarangan hingga dapat diakses publik.', 'M', 30, 750]];
            const LIC = [['I. Firearm License', [['Pistol License', 7500], ['Shotgun (SG) License', 10000]]], ['II. Truck Driver License', [['Low Trucker License', 2500], ['Heavy Trucker License', 5000]]]];
            const REG = ['Semua pemohon wajib melengkapi formulir pengajuan.', 'Semua lisensi harus disetujui LSPD.', 'Pemohon wajib membayar biaya lisensi yang berlaku.', 'Pelanggaran dapat berujung pada pencabutan lisensi.'];
            const $ = s => document.querySelector(s)
              , app = $('#app');
            const usd = n => '$' + n.toLocaleString('en-US')
              , jl = n => n >= 999 ? 'Seumur Hidup' : n + ' ' + UNIT
              , tp = t => t === 'F' ? 'Felony' : 'Misdemeanor';
            const esc = s => String(s).replace(/[&<>"]/g, c => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;'
            }[c]));
            const cat = d => d[0].split('.')[0];
            let q = ''
              , kat = ''
              , tip = ''
              , saved = []
              , hist = []
              , calc = {}
              , kq = '';
            try {
                saved = JSON.parse(localStorage.getItem('pr_saved') || '[]').filter(k => DATA.some(d => d[0] === k));
                hist = JSON.parse(localStorage.getItem('pr_hist') || '[]')
            } catch (e) {}
            const persist = () => {
                try {
                    localStorage.setItem('pr_saved', JSON.stringify(saved));
                    localStorage.setItem('pr_hist', JSON.stringify(hist))
                } catch (e) {}
            }
            ;
            function go(v) {
                location.hash = v
            }
            function addHist(t) {
                t = t.trim();
                if (!t)
                    return;
                hist = [t, ...hist.filter(x => x !== t)].slice(0, 30);
                persist()
            }
            function toggle(k) {
                saved = saved.includes(k) ? saved.filter(x => x !== k) : [...saved, k];
                persist();
                render()
            }
            function filt() {
                const s = q.toLowerCase();
                return DATA.filter(d => (!kat || cat(d) === kat) && (!tip || d[3] === tip) && (!s || (d[0] + ' ' + d[1] + ' ' + d[2] + ' ' + CATS[cat(d)] + ' ' + tp(d[3]) + ' ' + d[5]).toLowerCase().includes(s)))
            }
            function rows(list) {
                if (!list.length)
                    return '<div class="empty">Tidak ada pasal yang cocok.</div>';
                return '<div class="tbl"><table><tr><th>PASAL</th><th>PELANGGARAN</th><th>TIPE</th><th>PENJARA</th><th>DENDA</th><th></th></tr>' + list.map(d => `<tr><td class="kode">§ ${d[0]}</td><td><b>${esc(d[1])}</b><br><span class="mut sm">${esc(d[2])}</span><br><span class="mut sm">${CATS[cat(d)]}</span></td><td><span class="bd ${d[3]}">${tp(d[3])}</span></td><td>${jl(d[4])}</td><td>${usd(d[5])}</td><td><button class="star ${saved.includes(d[0]) ? 'on' : ''}" onclick="toggle('${d[0]}')" aria-label="Simpan">★</button></td></tr>`).join('') + '</table></div>'
            }
            function dash() {
                const top = [...DATA].sort( (a, b) => b[4] - a[4]).slice(0, 5);
                return `<h1>Selamat datang, LSPD Rebelions</h1><p class="mut">Database pasal, kalkulator sanksi, dan daftar harga lisensi.</p>
 <div class="stats"><div class="card"><span class="mut">Total pasal</span><b>${DATA.length}</b></div><div class="card"><span class="mut">Felony</span><b>${DATA.filter(d => d[3] === 'F').length}</b></div><div class="card"><span class="mut">Misdemeanor</span><b>${DATA.filter(d => d[3] === 'M').length}</b></div><div class="card"><span class="mut">Disimpan</span><b>${saved.length}</b></div></div>
 <div class="card" style="margin-top:14px"><h2>Pasal apa yang sedang kamu cari?</h2><p class="mut sm" style="margin:0 0 10px">Ketik kode, nama pelanggaran, kata kunci, kategori, atau nominal denda. (Ctrl+K)</p>
 <input type="search" id="qd" placeholder="Cari pasal…" value="${esc(q)}">
 <div class="row"><button onclick="doSearch($('#qd').value)">Cari pasal</button><span class="mut sm">Sering dicari:</span>${['Murder', 'Narcotics', 'DUI', 'Theft', 'Firearm'].map(t => `<button class="chip" onclick="doSearch('${t}')">${t}</button>`).join('')}</div></div>
 <div class="row" style="margin:0 0 14px"><a class="btn" href="#kalkulator">Buka kalkulator sanksi</a><a class="btn ghost" style="border:1px solid var(--bd);color:var(--ac);background:transparent" href="#lisensi">Harga lisensi</a></div>
 <h2>Kategori pasal</h2><div class="cats">${Object.entries(CATS).map( ([k,n]) => `<div class="card cat" onclick="kat='${k}';q='';tip='';go('pasal');render()"><span class="n">KATEGORI ${k}</span><b>${n}</b><span class="mut sm">${DATA.filter(d => cat(d) === k).length} pasal</span></div>`).join('')}</div>
 <div class="card"><h2>Hukuman terberat</h2>${rows(top)}</div>`
            }
            function koleksi() {
                return `<h1>Koleksi pasal</h1><div class="card"><input type="search" id="qk" placeholder="Cari kode, nama, kata kunci, atau denda…" value="${esc(q)}">
 <div class="row"><button class="chip ${!kat ? 'on' : ''}" onclick="kat='';render()">Semua kategori</button>${Object.entries(CATS).map( ([k,n]) => `<button class="chip ${kat === k ? 'on' : ''}" onclick="kat='${k}';render()">${k}. ${n}</button>`).join('')}</div>
 <div class="row"><button class="chip ${!tip ? 'on' : ''}" onclick="tip='';render()">Semua tipe</button><button class="chip ${tip === 'F' ? 'on' : ''}" onclick="tip='F';render()">Felony</button><button class="chip ${tip === 'M' ? 'on' : ''}" onclick="tip='M';render()">Misdemeanor</button></div></div>
 <div class="card" id="list">${rows(filt())}</div>`
            }
            function kalkulator() {
                return `<h1>Kalkulator denda &amp; penjara</h1><p class="mut">Klik pasal yang dilanggar, atur jumlahnya, total dihitung otomatis.</p><div class="kgrid"><div class="card"><h2>Pilih pasal</h2><input type="search" id="kq" placeholder="Cari pasal…" value="${esc(kq)}"><div id="kres" style="margin-top:10px"></div></div><div class="card"><h2>Perhitungan</h2><div id="kcart"></div></div></div>`
            }
            function totals() {
                let den = 0
                  , tm = 0
                  , life = false
                  , f = 0;
                Object.keys(calc).forEach(k => {
                    const d = DATA.find(x => x[0] === k)
                      , n = calc[k];
                    den += d[5] * n;
                    if (d[4] >= 999)
                        life = true;
                    else
                        tm += d[4] * n;
                    if (d[3] === 'F')
                        f += n
                }
                );
                return {
                    den,
                    life,
                    tm,
                    f
                }
            }
            function kfill() {
                const s = kq.toLowerCase();
                const r = DATA.filter(d => !s || (d[0] + ' ' + d[1] + ' ' + d[2]).toLowerCase().includes(s));
                $('#kres').innerHTML = r.length ? r.map(d => `<div class="pick" onclick="qty('${d[0]}',1)"><span class="kode">${d[0]}</span> <b>${esc(d[1])}</b> <span class="bd ${d[3]}">${tp(d[3])}</span><br><span class="mut sm">${usd(d[5])} · ${jl(d[4])}</span></div>`).join('') : '<div class="empty">Tidak ada pasal.</div>';
                const it = Object.keys(calc).map(k => {
                    const d = DATA.find(x => x[0] === k)
                      , n = calc[k];
                    return `<div class="citem"><div><span class="kode">${k}</span> ${esc(d[1])}<br><span class="mut sm">${usd(d[5])} · ${jl(d[4])}</span></div><div class="qty"><button class="ghost" onclick="qty('${k}',-1)">−</button><b>${n}</b><button class="ghost" onclick="qty('${k}',1)">+</button></div></div>`
                }
                ).join('');
                const t = totals();
                $('#kcart').innerHTML = (it || '<div class="empty">Belum ada pasal dipilih.</div>') + `<div class="tot"><div><span class="mut">Total denda</span><b>${usd(t.den)}</b></div><div><span class="mut">Total penjara</span><b>${t.life ? 'Seumur Hidup' : t.tm + ' ' + UNIT}</b></div><div><span class="mut">Felony</span><b>${t.f}</b></div></div><div class="row"><button onclick="copyK()">Salin ringkasan</button><button class="ghost" onclick="calc={};kfill()">Reset</button></div>`
            }
            function qty(k, n) {
                calc[k] = (calc[k] || 0) + n;
                if (calc[k] <= 0)
                    delete calc[k];
                kfill()
            }
            function copyK() {
                const t = totals();
                let s = 'Perhitungan pasal:\n';
                Object.keys(calc).forEach(k => {
                    const d = DATA.find(x => x[0] === k);
                    s += '- ' + k + ' ' + d[1] + ' x' + calc[k] + '\n'
                }
                );
                s += 'Total denda: ' + usd(t.den) + '\nTotal penjara: ' + (t.life ? 'Seumur Hidup' : t.tm + ' ' + UNIT);
                const a = document.createElement('textarea');
                a.value = s;
                document.body.appendChild(a);
                a.select();
                try {
                    document.execCommand('copy')
                } catch (e) {}
                a.remove()
            }
            function lisensi() {
                return `<h1>Harga lisensi</h1><p class="mul mut">Los Santos Police Department · Licensing Division</p><div class="kgrid">${LIC.map( ([n,l]) => `<div class="card"><h2>${n}</h2>${l.map( ([a,p]) => `<div class="lic"><span>${a}</span><b>${usd(p)}</b></div>`).join('')}</div>`).join('')}</div><div class="card"><h2>Ketentuan lisensi</h2>${REG.map(r => `<p style="margin:6px 0">• ${r}</p>`).join('')}<p class="mut sm">To Protect and To Serve</p></div>`
            }
            function disimpan() {
                return `<h1>Disimpan</h1><div class="card">${saved.length ? rows(DATA.filter(d => saved.includes(d[0]))) : '<div class="empty">Belum ada pasal tersimpan. Tekan ★ pada pasal untuk menyimpan.</div>'}</div>`
            }
            function riwayat() {
                return `<h1>Riwayat pencarian</h1><div class="card">${hist.length ? hist.map(h => `<button class="chip" style="margin:3px" onclick="doSearch(this.textContent)">${esc(h)}</button>`).join('') + '<div class="row"><button class="ghost" onclick="hist=[];persist();render()">Hapus riwayat</button></div>' : '<div class="empty">Belum ada riwayat pencarian.</div>'}</div>`
            }
            function doSearch(t) {
                q = t;
                kat = '';
                tip = '';
                addHist(t);
                if (location.hash === '#pasal')
                    render();
                else
                    go('pasal')
            }
            function render() {
                const v = (location.hash || '#dashboard').slice(1);
                const V = {
                    dashboard: dash,
                    pasal: koleksi,
                    kalkulator: kalkulator,
                    lisensi: lisensi,
                    disimpan: disimpan,
                    riwayat: riwayat
                };
                const cur = V[v] ? v : 'dashboard';
                $('#nav').innerHTML = [['dashboard', 'Dashboard'], ['pasal', 'Pasal (' + DATA.length + ')'], ['kalkulator', 'Kalkulator'], ['lisensi', 'Lisensi'], ['disimpan', 'Disimpan'], ['riwayat', 'Riwayat']].map( ([k,n]) => `<a href="#${k}" class="${k === cur ? 'on' : ''}">${n}</a>`).join('');
                app.innerHTML = V[cur]();
                const qk = $('#qk');
                if (qk) {
                    qk.oninput = e => {
                        q = e.target.value;
                        $('#list').innerHTML = rows(filt())
                    }
                    ;
                    qk.onchange = e => addHist(e.target.value)
                }
                if (cur === 'kalkulator') {
                    kfill();
                    $('#kq').oninput = e => {
                        kq = e.target.value;
                        kfill()
                    }
                }
                const qd = $('#qd');
                if (qd)
                    qd.onkeydown = e => {
                        if (e.key === 'Enter')
                            doSearch(qd.value)
                    }
                    ;
            }
            addEventListener('hashchange', render);
            addEventListener('keydown', e => {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    go('dashboard');
                    setTimeout( () => {
                        const i = $('#qd');
                        if (i)
                            i.focus()
                    }
                    , 50)
                }
            }
            );
            render();
        </script>
    </body>
</html>
